# ─────────────────────────────────────────────────────────────
# Starter .gitignore for a spec-driven (OpenSpec) project.
# Trim the language sections to match your stack.
#
# NOT ignored (intentionally tracked — share these with the team):
#   openspec/        specs + changes = source of truth
#   .claude/ .cursor/ OpenSpec-generated slash commands & skills
#   agents/          AGENTS.md, MEMORY.md
# ─────────────────────────────────────────────────────────────

# Secrets / local env — never commit
.env
.env.*
!.env.example
*.local
secrets.*
*.pem
*.key

# OS cruft
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
desktop.ini

# Editor / IDE
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.claude/settings.local.json

# Logs & temp
*.log
logs/
tmp/
.cache/
.openspec-test-*

# ── Node / JS ──────────────────────────────────────────────
node_modules/
dist/
build/
coverage/
.next/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── smartcrate app data (local-only, never committed) ──────
# (git ignore patterns don't allow trailing inline comments)
data/
downloads/
config/seeds.json

# ── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# ── Build artifacts (other langs — uncomment as needed) ────
# target/        # Rust / Java (Maven, Gradle)
# bin/ obj/      # Go / .NET
# vendor/        # Go / PHP
