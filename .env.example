# smartcrate environment — copy to .env and fill in. NEVER commit .env.
# Only NAMES are documented here; put real values in your local .env.

# Discogs personal access token (required for catalog/discovery).
# Create one at https://www.discogs.com/settings/developers
DISCOGS_TOKEN=

# Backend HTTP port (default 4321).
PORT=4321

# SQLite database file path (default ./data/smartcrate.db).
SMARTCRATE_DB_PATH=

# Directory for downloaded audio (default ./downloads). Requires yt-dlp + ffmpeg.
SMARTCRATE_DOWNLOAD_DIR=

# Path to the cold-start seed config (default ./config/seeds.json).
SMARTCRATE_SEED_CONFIG=

# yt-dlp audio settings (defaults: mp3 / quality 0 = 320kbps best).
SMARTCRATE_AUDIO_FORMAT=mp3
SMARTCRATE_AUDIO_QUALITY=0

# Recommender weights & queue (optional — sane defaults applied if unset).
SMARTCRATE_WEIGHT_LIKE=1
SMARTCRATE_WEIGHT_DISLIKE=1.5
SMARTCRATE_WEIGHT_ARTIST=1
SMARTCRATE_WEIGHT_LABEL=0.8
SMARTCRATE_WEIGHT_RELEASE=0.6
SMARTCRATE_EXPLORE_QUEUE_LENGTH=25
SMARTCRATE_DISLIKE_THRESHOLD=0
